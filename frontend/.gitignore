# See https://help.github.com/articles/ignoring-files/ for more information.

# Dependencies and package manager artifacts
/node_modules
/.pnp
.pnp.js

# Test output
/coverage

# Production build output
/build

# Miscellaneous ignores
.DS_Store

# Environment variables and secrets
.env
.env.bak
.env.local
.env.*.local
.env.*
!.env.example

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment file examples
# Keep sample environment files in the repository for configuration reference.
.env.example

# User-generated content
uploads/       # uncomment if you store uploads locally

# IDE and editor settings
.vscode/
.idea/
*.sublime-workspace
*.sublime-project